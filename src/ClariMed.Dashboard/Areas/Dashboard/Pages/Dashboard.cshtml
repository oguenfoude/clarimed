@page "/dashboard"
@model ClariMed.Dashboard.Areas.Dashboard.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Premium Background Element -->
<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-indigo-50/60 via-white to-white -z-10 pointer-events-none"></div>

<div class="mb-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 relative">
        <div class="relative z-10">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-600 text-[10px] uppercase tracking-widest font-black mb-4 shadow-sm">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
                </span>
                @Loc["Dashboard_LiveStatus"]
            </div>
            <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-slate-900 via-slate-800 to-slate-600 tracking-tight">@Loc["Dashboard_Title"]</h1>
            <p class="text-slate-500 mt-2 font-medium text-sm">@Loc["Dashboard_Subtitle"]</p>
        </div>
    </div>
</div>

<div class="space-y-8 relative z-10">
    <!-- Premium Global Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="group relative bg-white/70 backdrop-blur-xl rounded-3xl border border-white p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-[0_20px_40px_rgb(0,0,0,0.08)] transition-all duration-500 overflow-hidden">
            <div class="absolute -right-6 -top-6 w-32 h-32 bg-blue-500/10 rounded-full blur-2xl group-hover:bg-blue-500/20 transition-all duration-500"></div>
            <div class="relative z-10">
                <div class="flex items-center justify-between mb-4">
                    <p class="text-xs font-black text-slate-400 uppercase tracking-widest">@Loc["Dashboard_TotalPatients"]</p>
                    <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-500 flex items-center justify-center shadow-inner">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                    </div>
                </div>
                <p class="text-5xl font-black text-slate-800 tracking-tight">@Model.TotalPatients</p>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="group relative bg-white/70 backdrop-blur-xl rounded-3xl border border-white p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-[0_20px_40px_rgb(0,0,0,0.08)] transition-all duration-500 overflow-hidden">
            <div class="absolute -right-6 -top-6 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-all duration-500"></div>
            <div class="relative z-10">
                <div class="flex items-center justify-between mb-4">
                    <p class="text-xs font-black text-slate-400 uppercase tracking-widest">@Loc["Dashboard_TotalStudies"]</p>
                    <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-500 flex items-center justify-center shadow-inner">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                    </div>
                </div>
                <p class="text-5xl font-black text-slate-800 tracking-tight">@Model.TotalStudies</p>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="group relative bg-white/70 backdrop-blur-xl rounded-3xl border border-white p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-[0_20px_40px_rgb(0,0,0,0.08)] transition-all duration-500 overflow-hidden">
            <div class="absolute -right-6 -top-6 w-32 h-32 bg-violet-500/10 rounded-full blur-2xl group-hover:bg-violet-500/20 transition-all duration-500"></div>
            <div class="relative z-10">
                <div class="flex items-center justify-between mb-4">
                    <p class="text-xs font-black text-slate-400 uppercase tracking-widest">@Loc["Dashboard_TotalImages"]</p>
                    <div class="w-10 h-10 rounded-2xl bg-violet-50 text-violet-500 flex items-center justify-center shadow-inner">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                </div>
                <p class="text-5xl font-black text-slate-800 tracking-tight">@Model.TotalImages</p>
            </div>
        </div>
    </div>

    <!-- Modality Breakdown -->
    <div class="bg-white/80 backdrop-blur-2xl rounded-3xl border border-white p-8 shadow-[0_8px_30px_rgb(0,0,0,0.06)]">
        <div class="flex items-center justify-between mb-8">
            <h2 class="text-xl font-black text-slate-900 tracking-tight">@Loc["Dashboard_TodayModality"]</h2>
            <div class="text-xs font-bold text-slate-400 bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200">@Loc["Dashboard_RealTimeStats"]</div>
        </div>
        
        @if (Model.ModalityBreakdown.Count == 0)
        {
            <div class="py-16 text-center bg-slate-50/50 rounded-2xl border border-dashed border-slate-200">
                <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto mb-4 shadow-sm border border-slate-100">
                    <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path></svg>
                </div>
                <p class="text-slate-500 font-bold">@Loc["Dashboard_NoStudies"]</p>
                <p class="text-sm text-slate-400 mt-1">@Loc["Dashboard_NoStudiesDesc"]</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5">
                @foreach(var m in Model.ModalityBreakdown)
                {
                    <div class="group relative bg-gradient-to-b from-white to-slate-50/50 border border-slate-200/80 rounded-2xl p-6 text-center transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_12px_30px_rgb(0,0,0,0.08)] hover:border-indigo-200 cursor-default">
                        <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-t-2xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <p class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-br from-slate-800 to-slate-500 group-hover:from-indigo-600 group-hover:to-purple-600 mb-2 tracking-tight transition-all">@m.Count</p>
                        <p class="text-[11px] font-black text-slate-400 group-hover:text-indigo-500 uppercase tracking-widest transition-colors">@m.Modality</p>
                    </div>
                }
            </div>
        }
    </div>
</div>