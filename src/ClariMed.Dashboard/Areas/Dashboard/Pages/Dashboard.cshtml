@page "/dashboard"
@model ClariMed.Dashboard.Areas.Dashboard.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-6">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Dashboard</h1>
            <p class="text-slate-500 mt-1 text-sm">Monitoring clinic activity and imaging throughput</p>
        </div>
        <div class="flex items-center gap-2.5 bg-white border border-slate-200 rounded-lg px-4 py-2 shadow-sm shrink-0">
            <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
            <span class="text-xs font-semibold text-slate-600 uppercase tracking-wider">Live System Status</span>
        </div>
    </div>
</div>

<div id="studies-table"
     hx-get="/dashboard?handler=Table"
     hx-trigger="load, every 15s"
     hx-swap="outerHTML">
    <partial name="Shared/_StudiesTable" model="Model" />
</div>