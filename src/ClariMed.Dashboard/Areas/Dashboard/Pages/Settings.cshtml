@page "/settings"
@model ClariMed.Dashboard.Areas.Dashboard.Pages.SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<div class="mb-8">
    <h1 class="text-3xl font-black text-slate-800 tracking-tight">@Loc["Settings_Title"]</h1>
    <p class="text-sm text-slate-500 mt-1 font-medium">@Loc["Settings_Desc"]</p>
</div>

<div class="flex flex-col md:flex-row gap-8 items-start">
    <!-- Left Navigation -->
    <div class="w-full md:w-64 shrink-0 space-y-1 sticky top-6">
        <a href="/settings?section=general"
           class="block px-4 py-2.5 rounded-xl text-sm font-bold transition-colors @(Model.ActiveSection == "general" ? "bg-blue-50 text-blue-700" : "text-slate-600 hover:bg-slate-100 hover:text-slate-800")">
            @Loc["Settings_General"]
        </a>

        <a href="/settings?section=dicom"
           class="block px-4 py-2.5 rounded-xl text-sm font-bold transition-colors @(Model.ActiveSection == "dicom" ? "bg-blue-50 text-blue-700" : "text-slate-600 hover:bg-slate-100 hover:text-slate-800")">
            @Loc["Settings_DicomSettings"]
        </a>
        @if (Model.IsAdmin)
        {
            <a href="/settings?section=users"
               class="block px-4 py-2.5 rounded-xl text-sm font-bold transition-colors @(Model.ActiveSection == "users" ? "bg-blue-50 text-blue-700" : "text-slate-600 hover:bg-slate-100 hover:text-slate-800")">
                @Loc["Settings_UserManagement"]
            </a>
        }
    </div>

    <!-- Right Content -->
    <div id="settings-content" class="flex-1 max-w-3xl">
        @if (Model.ActiveSection == "general")
        {
            @await Html.PartialAsync("_SettingsGeneral", Model)
        }

        else if (Model.ActiveSection == "dicom")
        {
            @await Html.PartialAsync("_SettingsDicom", Model)
        }
        else if (Model.ActiveSection == "users" && Model.IsAdmin)
        {
            @await Html.PartialAsync("_SettingsUsers", Model)
        }
    </div>
</div>
