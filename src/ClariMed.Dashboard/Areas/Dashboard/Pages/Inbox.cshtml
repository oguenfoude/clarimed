@page "/inbox"
@model ClariMed.Dashboard.Areas.Dashboard.Pages.InboxModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Virtual Printer Inbox";
    var tokenSet = Antiforgery.GetAndStoreTokens(HttpContext);
    var requestToken = tokenSet.RequestToken;
}

<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="text-3xl font-black text-slate-800 tracking-tight">Virtual Printer Inbox</h1>
        <p class="text-sm text-slate-500 mt-1 font-medium">Assign captured printed documents (.pdf) to patient DICOM studies</p>
    </div>
    <div class="flex items-center gap-3 text-sm text-slate-600 bg-white px-5 py-3 border border-slate-200/60 rounded-xl shadow-sm">
        <span class="font-black text-slate-900 text-lg">@Model.UnassignedDocuments.Count</span> 
        <span class="font-bold tracking-wide uppercase text-[10px]">Pending Assignment</span>
    </div>
</div>

@if (Model.UnassignedDocuments.Count == 0)
{
    <div class="bg-white rounded-2xl border border-slate-200/60 shadow-[0_8px_30px_rgb(0,0,0,0.04)] py-32 text-center">
        <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-6 text-slate-400 border border-slate-100 shadow-inner">
            <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
            </svg>
        </div>
        <h3 class="text-xl font-black text-slate-800 mb-2 tracking-tight">Inbox is Empty</h3>
        <p class="text-slate-500 font-medium text-sm max-w-md mx-auto px-4">
            Print any document (Word, PDF, web page) to the virtual "ClariMed" printer. It will be automatically captured and appear here.
        </p>
    </div>
}
else
{
    <div class="flex flex-col lg:flex-row gap-8" x-data="{ selectedDocId: @(Model.UnassignedDocuments.First().Id) }">
        
        @* ── Left: Document List ── *@
        <div class="w-full lg:w-1/3 flex flex-col gap-4">
            <div class="space-y-4">
                @foreach (var doc in Model.UnassignedDocuments)
                {
                    var filename = System.IO.Path.GetFileName(doc.PdfFilePath ?? doc.OriginalFilePath);
                    var previewUrl = $"/inbox-docs/{filename}";
                    
                    <button type="button" 
                            @@click="selectedDocId = @doc.Id; setPreviewUrl('@previewUrl', @doc.Id)"
                            :class="selectedDocId === @doc.Id ? 'border-blue-500 bg-blue-50/30 ring-4 ring-blue-500/10 shadow-md' : 'border-slate-200/60 bg-white hover:border-slate-300 shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-md hover:-translate-y-0.5'"
                            class="w-full text-left rounded-2xl border p-5 transition-all outline-none flex items-start gap-4">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-rose-50 to-red-50 text-red-600 flex items-center justify-center shrink-0 border border-red-100 shadow-sm">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <div class="min-w-0 flex-1">
                            <h4 class="text-sm font-black text-slate-800 truncate" title="@doc.OriginalFileName">@doc.OriginalFileName</h4>
                            <p class="text-[11px] text-slate-500 mt-1.5 font-bold uppercase tracking-widest">@doc.ReceivedAt.ToString("MMM dd, yyyy HH:mm")</p>
                        </div>
                    </button>
                }
            </div>
        </div>

        @* ── Right: Preview and Assignment Workspace ── *@
        <div class="w-full lg:w-2/3">
            <div class="bg-white rounded-2xl border border-slate-200/60 shadow-[0_8px_30px_rgb(0,0,0,0.04)] p-8 flex flex-col gap-6 sticky top-6">
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Document Workspace</h3>
                    <p class="text-xs text-slate-500 mt-1">Review the document and select a patient study to attach it to.</p>
                </div>

                @* PDF Preview Frame *@
                <div class="border border-slate-200 rounded-xl overflow-hidden bg-slate-50 relative aspect-[4/3] w-full">
                    <iframe id="pdf-preview-frame" 
                            src="/inbox-docs/@(System.IO.Path.GetFileName(Model.UnassignedDocuments.First().PdfFilePath ?? Model.UnassignedDocuments.First().OriginalFilePath))" 
                            class="w-full h-full border-none">
                    </iframe>
                </div>

                @* Patient Link Form *@
                <div class="border-t border-slate-100 pt-8 mt-2">
                    <h4 class="text-sm font-black text-slate-800 mb-4 tracking-tight">Link Report to Patient DICOM Study</h4>
                    
                    <div class="space-y-5">
                        @* Autocomplete Search Input *@
                        <div>
                            <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Search Patient or Accession #</label>
                            <div class="relative">
                                <input type="text"
                                       name="q"
                                       placeholder="Type patient name, ID, or accession number..."
                                       hx-get="/inbox?handler=SearchPatients"
                                       hx-target="#search-results-container"
                                       hx-trigger="keyup changed delay:200ms"
                                       class="w-full bg-slate-50 hover:bg-slate-100/70 focus:bg-white border border-slate-200 focus:border-blue-500 rounded-xl px-4 py-3 text-sm font-bold text-slate-700 transition-all focus:ring-4 focus:ring-blue-500/20 outline-none" />
                                <div class="absolute right-4 top-3.5 text-slate-400">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                                    </svg>
                                </div>
                            </div>
                        </div>

                        @* Autocomplete Dropdown list *@
                        <div id="search-results-container" class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-lg max-h-60 overflow-y-auto hidden">
                            @* Dynamic search results will swap here *@
                        </div>

                        @* Selected Study Indicator *@
                        <div id="selected-study-badge" class="hidden p-5 bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-200/80 rounded-xl flex items-center justify-between shadow-sm">
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 shadow-inner">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-black tracking-widest text-emerald-600 uppercase">Target Study Selected</p>
                                    <p id="selected-study-text" class="text-sm font-bold text-slate-800 mt-0.5">Patient Name - Date</p>
                                </div>
                            </div>
                            <button type="button" onclick="clearSelectedStudy()" class="text-slate-400 hover:text-rose-500 transition-colors p-2 hover:bg-rose-50 rounded-lg">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                            </button>
                        </div>

                        @* Form submission *@
                        <form method="post" asp-page-handler="Attach" id="attach-form">
                            <input type="hidden" name="documentId" id="form-document-id" :value="selectedDocId" />
                            <input type="hidden" name="studyId" id="form-study-id" value="" />
                            
                            <button type="submit" 
                                    id="submit-attach-btn"
                                    disabled
                                    class="w-full bg-slate-100 text-slate-400 border border-slate-200 font-bold text-sm py-3.5 px-4 rounded-xl cursor-not-allowed transition-all uppercase tracking-wide">
                                Link to Study & Open Preview
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function setPreviewUrl(url, docId) {
        document.getElementById('pdf-preview-frame').src = url;
        document.getElementById('form-document-id').value = docId;
    }

    function selectStudy(studyId, text) {
        document.getElementById('form-study-id').value = studyId;
        document.getElementById('selected-study-text').innerText = text;
        
        // Show study badge
        const badge = document.getElementById('selected-study-badge');
        badge.classList.remove('hidden');
        
        // Hide dropdown results
        const container = document.getElementById('search-results-container');
        container.classList.add('hidden');
        
        // Enable button
        const btn = document.getElementById('submit-attach-btn');
        btn.disabled = false;
        btn.className = "w-full bg-gradient-to-r from-blue-600 to-blue-500 text-white font-black text-sm py-3.5 px-4 rounded-xl shadow-lg shadow-blue-500/25 transition-all hover:-translate-y-0.5 ring-1 ring-white/10 uppercase tracking-wide cursor-pointer";
    }

    function clearSelectedStudy() {
        document.getElementById('form-study-id').value = "";
        
        // Hide badge
        const badge = document.getElementById('selected-study-badge');
        badge.classList.add('hidden');
        
        // Disable button
        const btn = document.getElementById('submit-attach-btn');
        btn.disabled = true;
        btn.className = "w-full bg-slate-100 text-slate-400 border border-slate-200 font-bold text-sm py-3.5 px-4 rounded-xl cursor-not-allowed transition-all uppercase tracking-wide";
    }

    // Monitor input target element for dropdown show/hide
    document.addEventListener("DOMContentLoaded", () => {
        const input = document.querySelector('input[name="q"]');
        const container = document.getElementById('search-results-container');
        if (input && container) {
            input.addEventListener("input", () => {
                if (input.value.trim().length > 0) {
                    container.classList.remove('hidden');
                } else {
                    container.classList.add('hidden');
                }
            });
            // Close dropdown when clicking outside
            document.addEventListener("click", (e) => {
                if (!input.contains(e.target) && !container.contains(e.target)) {
                    container.classList.add('hidden');
                }
            });
        }
    });
</script>