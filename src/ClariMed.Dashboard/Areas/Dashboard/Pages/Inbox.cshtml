@page "/inbox"
@model ClariMed.Dashboard.Areas.Dashboard.Pages.InboxModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Virtual Printer Inbox";
    var tokenSet = Antiforgery.GetAndStoreTokens(HttpContext);
    var requestToken = tokenSet.RequestToken;
}

<!-- Premium Background Element -->
<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-50/60 via-white to-white -z-10 pointer-events-none"></div>

<div class="mb-10 relative z-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-blue-600 text-[10px] uppercase tracking-widest font-black mb-4 shadow-sm">
                <svg class="w-3.5 h-3.5 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg>
                @Loc["Inbox_IncomingDocs"]
            </div>
            <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-slate-900 via-slate-800 to-slate-600 tracking-tight">@Loc["Inbox_Title"]</h1>
            <p class="text-slate-500 mt-2 font-medium text-sm">@Loc["Inbox_Subtitle"]</p>
        </div>
        <div class="flex items-center gap-4 bg-white/80 backdrop-blur-md border border-white px-6 py-4 rounded-2xl shadow-[0_4px_12px_rgb(0,0,0,0.03)]">
            <span class="font-black text-blue-600 text-3xl leading-none tracking-tight">@Model.UnassignedDocuments.Count</span> 
            <span class="font-black tracking-widest uppercase text-[10px] text-slate-400">@Loc["Inbox_Pending"]</span>
        </div>
    </div>
</div>

@if (Model.UnassignedDocuments.Count == 0)
{
    <div class="bg-white/80 backdrop-blur-2xl rounded-3xl border border-white shadow-[0_8px_30px_rgb(0,0,0,0.06)] py-32 text-center relative z-10">
        <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm border border-slate-100">
            <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
            </svg>
        </div>
        <h3 class="text-2xl font-black text-slate-800 mb-2 tracking-tight">@Loc["Inbox_Empty"]</h3>
        <p class="text-slate-500 font-medium text-sm max-w-md mx-auto px-4">
            @Loc["Inbox_EmptyDesc"]
        </p>
    </div>
}
else
{
    <div class="flex flex-col lg:flex-row gap-8 relative z-10" x-data="{ selectedDocId: @(Model.UnassignedDocuments.First().Id) }">
        
        @* ── Left: Document List ── *@
        <div class="w-full lg:w-1/3 flex flex-col gap-4">
            <div class="space-y-4 pr-1">
                @foreach (var doc in Model.UnassignedDocuments)
                {
                    var filename = System.IO.Path.GetFileName(doc.PdfFilePath ?? doc.OriginalFilePath);
                    var previewUrl = $"/inbox-docs/{filename}";
                    
                    <button type="button" 
                            @@click="selectedDocId = @doc.Id; setPreviewUrl('@previewUrl', @doc.Id)"
                            :class="selectedDocId === @doc.Id ? 'border-blue-300 bg-gradient-to-br from-blue-50/80 to-white shadow-lg shadow-blue-500/10 scale-[1.02]' : 'border-white bg-white/60 hover:bg-white hover:border-slate-200 shadow-sm hover:shadow-md hover:-translate-y-0.5'"
                            class="w-full text-left rounded-3xl border backdrop-blur-xl p-5 transition-all duration-300 outline-none flex items-start gap-4 group">
                        <div :class="selectedDocId === @doc.Id ? 'bg-blue-500 text-white shadow-md shadow-blue-500/30' : 'bg-rose-50 text-rose-500 group-hover:bg-rose-100'" class="w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 transition-colors">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <div class="min-w-0 flex-1">
                            <h4 class="text-sm font-black text-slate-800 truncate tracking-tight" title="@doc.OriginalFileName">@doc.OriginalFileName</h4>
                            <p class="text-[10px] text-slate-400 mt-1 font-black uppercase tracking-widest">@doc.ReceivedAt.ToString("MMM dd, yyyy HH:mm")</p>
                        </div>
                    </button>
                }
            </div>
        </div>

        @* ── Right: Preview and Assignment Workspace ── *@
        <div class="w-full lg:w-2/3">
            <div class="bg-white/80 backdrop-blur-2xl rounded-3xl border border-white shadow-[0_8px_30px_rgb(0,0,0,0.06)] p-8 flex flex-col gap-6 sticky top-6">
                <div>
                    <h3 class="text-xl font-black text-slate-900 tracking-tight">@Loc["Inbox_Workspace"]</h3>
                    <p class="text-sm text-slate-500 mt-1 font-medium">@Loc["Inbox_WorkspaceDesc"]</p>
                </div>

                @* PDF Preview Frame *@
                <div class="border-2 border-slate-100 rounded-2xl overflow-hidden bg-slate-50 relative aspect-[4/3] w-full shadow-inner">
                    <iframe id="pdf-preview-frame" 
                            src="/inbox-docs/@(System.IO.Path.GetFileName(Model.UnassignedDocuments.First().PdfFilePath ?? Model.UnassignedDocuments.First().OriginalFilePath))" 
                            class="w-full h-full border-none">
                    </iframe>
                </div>

                @* Patient Link Form *@
                <div class="border-t-2 border-slate-100 pt-8 mt-2">
                    <h4 class="text-[11px] font-black text-slate-400 mb-4 tracking-widest uppercase">@Loc["Inbox_LinkStudy"]</h4>
                    
                    <div class="space-y-5">
                        @* Autocomplete Search Input *@
                        <div>
                            <div class="relative group">
                                <input type="text"
                                       name="q"
                                       placeholder="@Loc["Inbox_SearchPlaceholder"]"
                                       hx-get="/inbox?handler=SearchPatients"
                                       hx-target="#search-results-container"
                                       hx-trigger="keyup changed delay:200ms"
                                       class="w-full bg-slate-50 hover:bg-slate-100/70 focus:bg-white border-2 border-slate-100 focus:border-blue-500 rounded-2xl px-5 py-4 text-sm font-black text-slate-700 transition-all focus:ring-4 focus:ring-blue-500/10 outline-none shadow-sm placeholder:font-bold placeholder:text-slate-400" />
                                <div class="absolute right-5 top-4 text-slate-300 group-focus-within:text-blue-500 transition-colors">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                                    </svg>
                                </div>
                            </div>
                        </div>

                        @* Autocomplete Dropdown list *@
                        <div id="search-results-container" class="bg-white border-2 border-slate-100 rounded-2xl overflow-hidden shadow-xl max-h-60 overflow-y-auto hidden">
                            @* Dynamic search results will swap here *@
                        </div>

                        @* Selected Study Indicator *@
                        <div id="selected-study-badge" class="hidden p-5 bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-200/80 rounded-2xl flex items-center justify-between shadow-sm">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 shadow-inner">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-black tracking-widest text-emerald-600 uppercase">@Loc["Inbox_StudySelected"]</p>
                                    <p id="selected-study-text" class="text-sm font-black text-slate-800 mt-0.5 tracking-tight">Patient Name - Date</p>
                                </div>
                            </div>
                            <button type="button" onclick="clearSelectedStudy()" class="text-slate-400 hover:text-rose-500 transition-colors p-2 hover:bg-rose-50 rounded-xl">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                            </button>
                        </div>

                        @* Form submission *@
                        <form method="post" asp-page-handler="Attach" id="attach-form">
                            <input type="hidden" name="documentId" id="form-document-id" :value="selectedDocId" />
                            <input type="hidden" name="studyId" id="form-study-id" value="" />
                            
                            <button type="submit" 
                                    id="submit-attach-btn"
                                    disabled
                                    class="w-full bg-slate-100 text-slate-400 font-black text-sm py-4 px-4 rounded-2xl cursor-not-allowed transition-all uppercase tracking-widest border border-slate-200">
                                @Loc["Inbox_Btn_Link"]
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function setPreviewUrl(url, docId) {
        document.getElementById('pdf-preview-frame').src = url;
        document.getElementById('form-document-id').value = docId;
    }

    function selectStudy(studyId, text) {
        document.getElementById('form-study-id').value = studyId;
        document.getElementById('selected-study-text').innerText = text;
        
        // Show study badge
        const badge = document.getElementById('selected-study-badge');
        badge.classList.remove('hidden');
        
        // Hide dropdown results
        const container = document.getElementById('search-results-container');
        container.classList.add('hidden');
        
        // Enable button
        const btn = document.getElementById('submit-attach-btn');
        btn.disabled = false;
        btn.className = "w-full bg-gradient-to-r from-blue-600 to-blue-500 text-white font-black text-sm py-4 px-4 rounded-2xl shadow-lg shadow-blue-500/30 transition-all hover:-translate-y-1 ring-1 ring-white/20 uppercase tracking-widest cursor-pointer";
    }

    function clearSelectedStudy() {
        document.getElementById('form-study-id').value = "";
        
        // Hide badge
        const badge = document.getElementById('selected-study-badge');
        badge.classList.add('hidden');
        
        // Disable button
        const btn = document.getElementById('submit-attach-btn');
        btn.disabled = true;
        btn.className = "w-full bg-slate-100 text-slate-400 font-black text-sm py-4 px-4 rounded-2xl cursor-not-allowed transition-all uppercase tracking-widest border border-slate-200";
    }

    // Monitor input target element for dropdown show/hide
    document.addEventListener("DOMContentLoaded", () => {
        const input = document.querySelector('input[name="q"]');
        const container = document.getElementById('search-results-container');
        if (input && container) {
            input.addEventListener("input", () => {
                if (input.value.trim().length > 0) {
                    container.classList.remove('hidden');
                } else {
                    container.classList.add('hidden');
                }
            });
            // Close dropdown when clicking outside
            document.addEventListener("click", (e) => {
                if (!input.contains(e.target) && !container.contains(e.target)) {
                    container.classList.add('hidden');
                }
            });
        }
    });
</script>