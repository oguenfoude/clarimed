@page "/recyclebin"
@model ClariMed.Dashboard.Areas.Dashboard.Pages.RecycleBinModel
@{
    ViewData["Title"] = "Recycle Bin";
}

<!-- Premium Background Element -->
<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-rose-50/60 via-white to-white -z-10 pointer-events-none"></div>

<div class="mb-10 relative z-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-50 border border-rose-100 text-rose-600 text-[10px] uppercase tracking-widest font-black mb-4 shadow-sm">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                @Loc["RecycleBin_DeletedItems"]
            </div>
            <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-slate-900 via-slate-800 to-slate-600 tracking-tight">@Loc["RecycleBin_Title"]</h1>
            <p class="text-slate-500 mt-2 font-medium text-sm">@Loc["RecycleBin_Subtitle"]</p>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="bg-white/80 backdrop-blur-2xl rounded-2xl border border-white p-5 mb-8 flex flex-wrap gap-4 items-center shadow-[0_8px_30px_rgb(0,0,0,0.04)] sticky top-6 z-20">
    <!-- Search Input -->
    <div class="relative flex-1 min-w-[240px]">
        <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-slate-400 pointer-events-none">
            <svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
        </span>
        <input type="text" name="search" id="rb-search" placeholder="Search by name or ID..."
               class="pl-11 pr-4 py-3 w-full bg-slate-50 border border-slate-200 rounded-xl text-sm font-bold text-slate-700 focus:bg-white focus:ring-4 focus:ring-rose-500/20 focus:border-rose-500 outline-none transition-all placeholder:font-medium placeholder:text-slate-400"
               hx-get="/recyclebin?handler=Table"
               hx-trigger="keyup changed delay:300ms"
               hx-target="#recyclebin-table"
               hx-swap="outerHTML"
               hx-include="#rb-search,#rb-modality,#rb-date-start,#rb-date-end" />
    </div>

    <div class="h-10 w-px bg-slate-200 hidden md:block"></div>

    <!-- Modality Dropdown -->
    <select name="modality" id="rb-modality"
            class="px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-bold text-slate-700 focus:bg-white focus:ring-4 focus:ring-rose-500/20 focus:border-rose-500 outline-none transition-all cursor-pointer"
            hx-get="/recyclebin?handler=Table"
            hx-trigger="change"
            hx-target="#recyclebin-table"
            hx-swap="outerHTML"
            hx-include="#rb-search,#rb-modality,#rb-date-start,#rb-date-end">
        <option value="">All Modalities</option>
        @foreach (var m in Model.Modalities)
        {
            <option value="@m">@m</option>
        }
    </select>

    <div class="h-10 w-px bg-slate-200 hidden md:block"></div>

    <!-- Date Range Picker -->
    <div class="flex items-center gap-2">
        <input type="date" name="startDate" id="rb-date-start"
               class="px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-bold text-slate-700 focus:bg-white focus:ring-4 focus:ring-rose-500/20 focus:border-rose-500 outline-none transition-all cursor-pointer"
               hx-get="/recyclebin?handler=Table"
               hx-trigger="change"
               hx-target="#recyclebin-table"
               hx-swap="outerHTML"
               hx-include="#rb-search,#rb-modality,#rb-date-start,#rb-date-end" />
               
        <span class="text-sm font-medium text-slate-400">to</span>
        
        <input type="date" name="endDate" id="rb-date-end"
               class="px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-bold text-slate-700 focus:bg-white focus:ring-4 focus:ring-rose-500/20 focus:border-rose-500 outline-none transition-all cursor-pointer"
               hx-get="/recyclebin?handler=Table"
               hx-trigger="change"
               hx-target="#recyclebin-table"
               hx-swap="outerHTML"
               hx-include="#rb-search,#rb-modality,#rb-date-start,#rb-date-end" />
    </div>

    <!-- Clear Button -->
    <button type="button"
            class="px-5 py-3 text-sm font-bold text-slate-500 hover:text-rose-600 hover:bg-rose-50 rounded-xl transition-all whitespace-nowrap focus:ring-4 focus:ring-rose-500/20"
            onclick="document.getElementById('rb-search').value='';document.getElementById('rb-modality').value='';document.getElementById('rb-date-start').value='';document.getElementById('rb-date-end').value='';"
            hx-get="/recyclebin?handler=Table"
            hx-trigger="click"
            hx-target="#recyclebin-table"
            hx-swap="outerHTML">
        Clear
    </button>
</div>

<!-- Table Container -->
<div id="recyclebin-table-container">
    <partial name="Shared/_RecycleBinTable" model="Model" />
</div>
