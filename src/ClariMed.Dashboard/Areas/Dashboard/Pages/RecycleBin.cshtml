@page "/recyclebin"
@model ClariMed.Dashboard.Areas.Dashboard.Pages.RecycleBinModel
@{
    ViewData["Title"] = "Recycle Bin";
}

<!-- Premium Background Element -->
<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-rose-50/60 via-white to-white -z-10 pointer-events-none"></div>

<div class="mb-10 relative z-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-50 border border-rose-100 text-rose-600 text-[10px] uppercase tracking-widest font-black mb-4 shadow-sm">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                @Loc["RecycleBin_DeletedItems"]
            </div>
            <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-slate-900 via-slate-800 to-slate-600 tracking-tight">@Loc["RecycleBin_Title"]</h1>
            <p class="text-slate-500 mt-2 font-medium text-sm">@Loc["RecycleBin_Subtitle"]</p>
        </div>
    </div>
</div>

<div class="bg-white/80 backdrop-blur-2xl rounded-3xl border border-white p-6 sm:p-8 shadow-[0_8px_30px_rgb(0,0,0,0.06)] relative z-10">
    <div class="overflow-x-auto min-h-[400px]">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b-2 border-slate-100">
                    <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">@Loc["RecycleBin_Col_Patient"]</th>
                    <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest hidden sm:table-cell">@Loc["RecycleBin_Col_Modality"]</th>
                    <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest hidden md:table-cell">@Loc["RecycleBin_Col_Date"]</th>
                    <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">@Loc["RecycleBin_Col_DeletedAt"]</th>
                    <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">@Loc["RecycleBin_Col_Actions"]</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100/80">
                @if (Model.DeletedStudies.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="px-6 py-20 text-center">
                            <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm border border-slate-100">
                                <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </div>
                            <p class="text-lg font-black text-slate-700 tracking-tight">@Loc["RecycleBin_Empty"]</p>
                            <p class="text-sm font-medium text-slate-400 mt-2">@Loc["RecycleBin_EmptyDesc"]</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var s in Model.DeletedStudies)
                    {
                        <tr class="group hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-5 align-middle">
                                <div class="font-black text-slate-800 text-sm tracking-tight">@s.PatientName</div>
                                <div class="text-[11px] text-slate-400 font-bold tracking-wider mt-1 uppercase">@s.PatientId</div>
                            </td>
                            <td class="px-6 py-5 align-middle hidden sm:table-cell">
                                <span class="inline-flex items-center px-3 py-1 rounded-lg text-[10px] font-black bg-slate-100 text-slate-600 border border-slate-200 uppercase tracking-widest">
                                    @s.Modality
                                </span>
                            </td>
                            <td class="px-6 py-5 align-middle hidden md:table-cell">
                                <div class="text-sm font-bold text-slate-600">
                                    @(s.StudyDate?.ToString("yyyy-MM-dd") ?? "Unknown")
                                </div>
                            </td>
                            <td class="px-6 py-5 align-middle">
                                <div class="text-[11px] font-bold text-rose-500 uppercase tracking-wider">
                                    @s.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                </div>
                            </td>
                            <td class="px-6 py-5 align-middle text-right">
                                <div class="flex items-center justify-end gap-3">
                                    <!-- Restore Button -->
                                    <form method="post" asp-page-handler="Restore" asp-route-id="@s.Id">
                                        <button type="submit" class="px-4 py-2 text-xs font-black text-emerald-600 bg-white hover:bg-emerald-50 rounded-xl transition-all border border-emerald-200/50 hover:border-emerald-300 shadow-sm hover:shadow uppercase tracking-wider">
                                            @Loc["RecycleBin_Btn_Restore"]
                                        </button>
                                    </form>

                                    <!-- Permanent Delete Button -->
                                    <form method="post" asp-page-handler="ForceDelete" asp-route-id="@s.Id" 
                                          onsubmit="return confirm('@Html.Raw(Loc["RecycleBin_ConfirmDelete"])');">
                                        <button type="submit" class="px-4 py-2 text-xs font-black text-white bg-rose-500 hover:bg-rose-600 rounded-xl transition-all shadow-md shadow-rose-500/20 hover:shadow-lg hover:-translate-y-0.5 uppercase tracking-wider">
                                            @Loc["RecycleBin_Btn_DeleteForever"]
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
