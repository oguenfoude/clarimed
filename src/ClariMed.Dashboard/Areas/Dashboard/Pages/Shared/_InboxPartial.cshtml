@model IEnumerable<ClariMed.Data.Models.Document>

@if (!Model.Any())
{
    <div class="text-center py-16">
        <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-300">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
        </div>
        <h3 class="text-slate-500 font-medium">Inbox is empty</h3>
        <p class="text-sm text-slate-400 mt-1">Print a document to the ClariMed Virtual Printer to see it here.</p>
    </div>
}
else
{
    <div class="space-y-3">
        @foreach (var doc in Model)
        {
            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-indigo-300 transition-all group flex flex-col gap-3">
                <div class="flex items-start justify-between gap-4">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-10 h-10 bg-indigo-50 text-indigo-505 rounded-lg flex items-center justify-center shrink-0 border border-indigo-100">
                            <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <div class="min-w-0">
                            <h4 class="text-sm font-bold text-slate-900 truncate" title="@doc.OriginalFileName">@doc.OriginalFileName</h4>
                            <p class="text-xs font-semibold text-slate-500 mt-0.5">@doc.ReceivedAt.ToString("MMM dd, yyyy HH:mm")</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}