@model ClariMed.Dashboard.Areas.Dashboard.Pages.AssignModel

<div id="patients-table">
    @if (Model.Studies.Count == 0)
    {
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm py-16 text-center">
            <div class="w-16 h-16 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4 text-slate-400">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
            </div>
            <p class="text-slate-600 font-medium text-base">No patients found</p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left min-w-[700px]">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50/80">
                            <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Patient</th>
                            <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Modality</th>
                            <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Accession</th>
                            <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Study Date</th>
                            <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var study in Model.Studies)
                        {
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-4">
                                    <span class="text-sm font-bold text-slate-900 block">@study.PatientName</span>
                                    <span class="text-xs text-slate-500 font-medium">ID: @study.PatientId</span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-xs font-bold uppercase tracking-wider px-2 py-1 bg-slate-100 text-slate-600 border border-slate-200 rounded">
                                        @study.Modality
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-sm font-medium text-slate-700">
                                    @study.AccessionNumber
                                </td>
                                <td class="px-6 py-4 text-sm font-medium text-slate-500">
                                    @(study.StudyDate?.ToString("MMM dd, yyyy") ?? "N/A")
                                </td>
                                <td class="px-6 py-4">
                                    @if (study.Status == ClariMed.Data.Models.StudyStatus.Receiving)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200/60">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                            Receiving
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200/60">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                            Complete
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    @if (study.IsAssigned)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-bold bg-slate-100 text-slate-500 border border-slate-200 uppercase tracking-wide">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                            Linked
                                        </span>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Assign" class="inline">
                                            <input type="hidden" name="inboxDocId" value="@Model.InboxDocId" />
                                            <input type="hidden" name="studyId" value="@study.Id" />
                                            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs py-2 px-4 rounded-xl shadow-sm hover:shadow transition-all">
                                                Assign
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>