@{
    var path = Context.Request.Path.Value ?? "";
    bool isDashboard = path.Equals("/dashboard", StringComparison.OrdinalIgnoreCase) || path.Equals("/", StringComparison.OrdinalIgnoreCase);
    bool isPatients = path.StartsWith("/patients", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/preview", StringComparison.OrdinalIgnoreCase);
    bool isSettings = path.StartsWith("/settings", StringComparison.OrdinalIgnoreCase);
    
    // Read sidebar state from cookie (defaults to open)
    bool isSidebarOpen = Context.Request.Cookies["sidebarOpen"] != "false";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClariMed — @ViewData["Title"]</title>
    
    <script src="/lib/htmx.min.js"></script>
    <script src="/lib/tailwind.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#f0f9ff', 100: '#e0f2fe', 500: '#0ea5e9', 600: '#0284c7', 700: '#0369a1' },
                        sidebar: '#0f172a'
                    }
                }
            }
        }
    </script>
    <script src="/lib/alpine.min.js" defer></script>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
    </style>
</head>
<body x-data="{ sidebarOpen: @(isSidebarOpen.ToString().ToLower()) }" x-init="$watch('sidebarOpen', val => document.cookie = `sidebarOpen=${val};path=/;max-age=31536000`)" class="bg-slate-50 text-slate-800 font-sans antialiased flex h-screen overflow-hidden">

    <!-- Sidebar -->
    <aside :class="sidebarOpen ? 'w-64' : 'w-20'" class="@(isSidebarOpen ? "w-64" : "w-20") bg-gradient-to-b from-indigo-950 via-slate-900 to-slate-950 border-r border-indigo-900/30 flex flex-col shrink-0 text-white shadow-2xl transition-all duration-300 relative z-20">
        <button @@click="sidebarOpen = !sidebarOpen" class="px-4 py-6 border-b border-slate-800 flex justify-center h-20 items-center w-full hover:bg-white/5 transition-colors focus:outline-none group">
            <div class="flex items-center gap-3 overflow-hidden whitespace-nowrap w-full @(isSidebarOpen ? "px-2" : "justify-center")" :class="sidebarOpen ? 'px-2' : 'justify-center'">
                <div class="w-10 h-10 shrink-0 rounded-xl bg-gradient-to-br from-blue-600 to-blue-500 flex items-center justify-center shadow-lg shadow-blue-500/25 ring-1 ring-white/10 group-hover:scale-105 transition-transform">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 9.172V5L8 4z"/>
                    </svg>
                </div>
                <div x-show="sidebarOpen" style="@(isSidebarOpen ? "" : "display:none;")" x-transition.opacity.duration.300ms class="flex-1 text-left">
                    <h1 class="text-xl font-bold tracking-tight text-white">ClariMed</h1>
                    <p class="text-[10px] text-slate-400 font-semibold uppercase tracking-widest mt-0.5">Clinical Portal</p>
                </div>
            </div>
        </button>

        <!-- Sidebar Navigation -->
        <nav class="flex-1 px-3 py-6 flex flex-col space-y-2">
            <div class="space-y-2">
                <a href="/dashboard" class="flex items-center gap-3 px-3 py-3 rounded-xl transition-all duration-200 group font-medium text-sm @(isDashboard ? "bg-gradient-to-r from-blue-600 to-blue-500 text-white shadow-lg shadow-blue-500/25 ring-1 ring-white/10" : "text-slate-400 hover:bg-white/5 hover:text-white") @(!isSidebarOpen ? "justify-center" : "")" :title="sidebarOpen ? '' : '@Loc["Sidebar_Dashboard"]'" :class="!sidebarOpen && 'justify-center'">
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2v-4zM14 16a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2v-4z"/>
                    </svg>
                    <span x-show="sidebarOpen" style="@(isSidebarOpen ? "" : "display:none;")" x-transition.opacity.duration.300ms class="whitespace-nowrap">@Loc["Sidebar_Dashboard"]</span>
                </a>

                <a href="/patients" class="flex items-center gap-3 px-3 py-3 rounded-xl transition-all duration-200 group font-medium text-sm @(isPatients ? "bg-gradient-to-r from-blue-600 to-blue-500 text-white shadow-lg shadow-blue-500/25 ring-1 ring-white/10" : "text-slate-400 hover:bg-white/5 hover:text-white") @(!isSidebarOpen ? "justify-center" : "")" :title="sidebarOpen ? '' : '@Loc["Sidebar_Patients"]'" :class="!sidebarOpen && 'justify-center'">
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span x-show="sidebarOpen" style="@(isSidebarOpen ? "" : "display:none;")" x-transition.opacity.duration.300ms class="whitespace-nowrap">@Loc["Sidebar_Patients"]</span>
                </a>
            </div>

            <div class="mt-auto pt-6 border-t border-slate-700/50 space-y-2">
                <a href="/recyclebin" class="flex items-center gap-3 px-3 py-3 rounded-xl transition-all duration-200 group font-medium text-sm text-slate-400 hover:bg-rose-500/10 hover:text-rose-400 @(!isSidebarOpen ? "justify-center" : "")" :title="sidebarOpen ? '' : '@Loc["Sidebar_RecycleBin"]'" :class="!sidebarOpen && 'justify-center'">
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                    <span x-show="sidebarOpen" style="@(isSidebarOpen ? "" : "display:none;")" x-transition.opacity.duration.300ms class="whitespace-nowrap">@Loc["Sidebar_RecycleBin"]</span>
                </a>

                <a href="/settings" class="flex items-center gap-3 px-3 py-3 rounded-xl transition-all duration-200 group font-medium text-sm @(isSettings ? "bg-gradient-to-r from-blue-600 to-blue-500 text-white shadow-lg shadow-blue-500/25 ring-1 ring-white/10" : "text-slate-400 hover:bg-white/5 hover:text-white") @(!isSidebarOpen ? "justify-center" : "")" :title="sidebarOpen ? '' : '@Loc["Sidebar_Settings"]'" :class="!sidebarOpen && 'justify-center'">
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span x-show="sidebarOpen" style="@(isSidebarOpen ? "" : "display:none;")" x-transition.opacity.duration.300ms class="whitespace-nowrap">@Loc["Sidebar_Settings"]</span>
                </a>

                <div class="pt-4 mt-2 border-t border-slate-700/50">
                    <a href="/system-stop" class="flex items-center gap-3 px-3 py-3 rounded-xl transition-all duration-200 group font-medium text-sm text-rose-400 hover:bg-rose-500/10 hover:text-rose-500 @(!isSidebarOpen ? "justify-center" : "")" :title="sidebarOpen ? '' : 'Stop System'" :class="!sidebarOpen && 'justify-center'">
                        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10h6v4H9z" />
                        </svg>
                        <span x-show="sidebarOpen" style="@(isSidebarOpen ? "" : "display:none;")" x-transition.opacity.duration.300ms class="whitespace-nowrap">Stop System</span>
                    </a>
                </div>
            </div>
        </nav>

        <div class="px-6 py-6 border-t border-slate-800 text-xs text-slate-500 font-medium overflow-hidden whitespace-nowrap text-center @(isSidebarOpen ? "text-left" : "text-[10px]")" :class="sidebarOpen ? 'text-left' : 'text-[10px]'">
            <span x-show="sidebarOpen" x-transition style="@(isSidebarOpen ? "" : "display:none;")">ClariMed v1.0</span>
            <span x-show="!sidebarOpen" x-transition style="@(!isSidebarOpen ? "" : "display:none;")">v1.0</span>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col min-w-0 transition-all duration-300 relative">
        <!-- Header -->
        <header class="h-16 bg-white/70 backdrop-blur-lg border-b border-slate-200/60 flex items-center justify-between px-6 shrink-0 z-30 sticky top-0">
            <div class="flex items-center gap-4">
                <h2 class="text-xl font-black text-slate-800 tracking-tight">@ViewData["Title"]</h2>
            </div>
            
            <div class="flex items-center gap-6">
                <!-- Status Dot -->
                <div class="flex items-center gap-2">
                    <div class="relative flex h-2.5 w-2.5">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                    </div>
                    <span class="text-xs font-bold text-slate-500 hidden sm:block">DICOM Server Active</span>
                </div>
                
                <!-- Time -->
                <div class="text-xs font-semibold text-slate-400">
                    @DateTime.Now.ToString("dd MMM yyyy HH:mm")
                </div>

                <!-- User Menu -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="flex items-center gap-3 pl-4 border-l border-slate-200">
                        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-xs font-bold shadow-md">
                            @(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <div class="hidden sm:block">
                            <p class="text-sm font-semibold text-slate-700 leading-tight">@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name)</p>
                            <p class="text-[10px] text-slate-400 font-medium">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User")</p>
                        </div>
                        <a href="/login?handler=logout" class="ml-1 p-1.5 rounded-lg text-slate-400 hover:text-rose-500 hover:bg-rose-50 transition-colors" title="Sign out">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                        </a>
                    </div>
                }
            </div>
        </header>

        <!-- Page Content -->
        <main class="flex-1 p-8 overflow-y-auto">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>