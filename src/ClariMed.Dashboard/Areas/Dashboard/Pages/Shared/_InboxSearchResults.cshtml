@model List<ClariMed.Data.Models.Study>

@if (Model == null || Model.Count == 0)
{
    <div class="p-4 text-center text-sm text-slate-500 font-medium">
        No matching patient studies found.
    </div>
}
else
{
    <ul class="divide-y divide-slate-100">
        @foreach (var study in Model)
        {
            var displayName = study.Patient?.Name ?? "Unknown";
            var displayDate = study.StudyDate?.ToString("MMM dd, yyyy") ?? study.CreatedAt.ToString("MMM dd, yyyy");
            
            <li>
                <button type="button" 
                        class="w-full text-left px-4 py-3 hover:bg-blue-50 transition-colors focus:bg-blue-50 outline-none flex flex-col"
                        onclick="selectStudy(@study.Id, '@(displayName.Replace("'", "\\'")) - @displayDate')">
                    <span class="text-sm font-bold text-slate-800 block">@displayName</span>
                    <span class="text-xs text-slate-500 mt-0.5 flex gap-2">
                        <span>ID: @study.Patient?.PatientId</span>
                        <span>&bull;</span>
                        <span>Acc: @study.AccessionNumber</span>
                        <span>&bull;</span>
                        <span>@displayDate</span>
                    </span>
                </button>
            </li>
        }
    </ul>
}
