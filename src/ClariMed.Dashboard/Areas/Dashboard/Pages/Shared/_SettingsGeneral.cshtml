@model ClariMed.Dashboard.Areas.Dashboard.Pages.SettingsModel

<form hx-post="/settings?handler=Language" hx-target="#general-result" hx-swap="innerHTML">
    <div id="general" class="mb-10">
        <h2 class="text-lg font-black text-slate-800 mb-4 tracking-tight">@Loc["Settings_General"]</h2>
        <div class="bg-white rounded-2xl border border-slate-200/60 p-6 shadow-[0_8px_30px_rgb(0,0,0,0.04)]">
            <label class="block text-sm font-black text-slate-700 mb-2 uppercase tracking-wide">@Loc["Settings_LanguageLabel"]</label>
            <p class="text-xs text-slate-500 mb-4 font-medium">@Loc["Settings_LanguageDesc"]</p>
            <div class="relative">
                <select name="Language" class="w-full pl-4 pr-10 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-bold text-slate-700 focus:bg-white focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all cursor-pointer appearance-none">
                    <option value="en" selected="@(Model.Settings?.Language == "en")">English (US)</option>
                    <option value="fr" selected="@(Model.Settings?.Language == "fr")">Français</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-500">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </div>
            </div>
        </div>
    </div>
    <div class="flex items-center gap-4 bg-slate-50/50 p-4 rounded-2xl border border-slate-200/60">
        <button type="submit" class="px-8 py-3 bg-gradient-to-r from-blue-600 to-blue-500 text-white rounded-xl hover:from-blue-700 hover:to-blue-600 text-sm font-bold shadow-lg shadow-blue-500/25 transition-all hover:-translate-y-0.5 ring-1 ring-white/10">
            @Loc["Settings_Save"]
        </button>
        <span id="general-result" class="text-sm font-bold text-emerald-600"></span>
    </div>
</form>

<div class="mt-12 mb-10">
    <h2 class="text-lg font-black text-slate-800 mb-4 tracking-tight">@Loc["Settings_Machines"]</h2>
    <p class="text-xs text-slate-500 mb-6 font-medium">@Loc["Settings_MachinesDesc"]</p>
    
    <div class="bg-white rounded-2xl border border-slate-200/60 shadow-[0_8px_30px_rgb(0,0,0,0.04)] p-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="p-5 bg-slate-50 rounded-xl border border-slate-100">
                <span class="block text-xs font-black text-slate-500 uppercase tracking-wider mb-2">@Loc["Settings_MachineIP"]</span>
                <span class="block text-lg font-black text-slate-800">@Model.LocalIpAddress</span>
            </div>
            <div class="p-5 bg-slate-50 rounded-xl border border-slate-100">
                <span class="block text-xs font-black text-slate-500 uppercase tracking-wider mb-2">@Loc["Settings_MachineAETitle"]</span>
                <span class="block text-lg font-black text-slate-800">@(Model.Settings?.AETitle ?? "CLARIMED")</span>
            </div>
            <div class="p-5 bg-slate-50 rounded-xl border border-slate-100">
                <span class="block text-xs font-black text-slate-500 uppercase tracking-wider mb-2">@Loc["Settings_MachinePort"]</span>
                <span class="block text-lg font-black text-slate-800">@(Model.Settings?.DicomPort ?? 104)</span>
            </div>
        </div>
        <div class="mt-6 p-4 bg-blue-50 text-blue-700 text-sm font-medium rounded-xl border border-blue-100 flex items-start gap-3">
            <svg class="w-5 h-5 shrink-0 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <div>
                Enter the details above into your CT or MRI machine's DICOM configuration to allow it to push studies to ClariMed.
            </div>
        </div>
    </div>
</div>
