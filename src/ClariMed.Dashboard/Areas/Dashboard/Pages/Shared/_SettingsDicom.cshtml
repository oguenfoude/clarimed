@model ClariMed.Dashboard.Areas.Dashboard.Pages.SettingsModel

<form hx-post="/settings?handler=Dicom" hx-target="#dicom-result" hx-swap="innerHTML">
    <div class="mb-10">
        <h2 class="text-lg font-black text-slate-800 mb-4 tracking-tight">@Loc["Settings_DicomSettings"]</h2>
        <div class="bg-white rounded-2xl border border-slate-200/60 p-6 shadow-[0_8px_30px_rgb(0,0,0,0.04)] space-y-5">
            <div class="flex items-center justify-between">
                <div>
                    <label class="block text-sm font-black text-slate-700 uppercase tracking-wide">@Loc["Settings_DicomStatus"]</label>
                    <p class="text-xs text-slate-500 mt-1 font-medium">@Loc["Settings_DicomStatusDesc"]</p>
                </div>
                <div id="dicom-status" hx-get="/settings?handler=DicomStatus" hx-trigger="every 3s" hx-swap="innerHTML">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                        Active
                    </span>
                </div>
            </div>
            <div class="border-t border-slate-100 pt-5">
                <label class="block text-sm font-black text-slate-700 mb-2 uppercase tracking-wide">@Loc["Settings_AETitle"]</label>
                <p class="text-xs text-slate-500 mb-3 font-medium">@Loc["Settings_AETitleDesc"]</p>
                <input type="text" name="AETitle" value="@Model.Settings?.AETitle"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-bold text-slate-700 focus:bg-white focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all" />
            </div>
            <div class="border-t border-slate-100 pt-5">
                <label class="block text-sm font-black text-slate-700 mb-2 uppercase tracking-wide">@Loc["Settings_DicomPort"]</label>
                <p class="text-xs text-slate-500 mb-3 font-medium">@Loc["Settings_DicomPortDesc"]</p>
                <input type="number" name="DicomPort" value="@Model.Settings?.DicomPort" min="1" max="65535"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-bold text-slate-700 focus:bg-white focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all" />
            </div>
            <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-xs text-amber-700 font-medium">
                @Loc["Settings_DicomRestartNote"]
            </div>
        </div>
    </div>
    <div class="flex items-center gap-4 bg-slate-50/50 p-4 rounded-2xl border border-slate-200/60">
        <button type="submit" class="px-8 py-3 bg-gradient-to-r from-blue-600 to-blue-500 text-white rounded-xl hover:from-blue-700 hover:to-blue-600 text-sm font-bold shadow-lg shadow-blue-500/25 transition-all hover:-translate-y-0.5 ring-1 ring-white/10">
            @Loc["Settings_ApplyRestart"]
        </button>
        <span id="dicom-result" class="text-sm font-bold"></span>
    </div>
</form>
