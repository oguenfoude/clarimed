@model ClariMed.Dashboard.Areas.Dashboard.Pages.DashboardModel

<div id="studies-table" class="space-y-8">



    <!-- Details Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Recent Studies List (2/3 width) -->
        <div class="lg:col-span-2 flex flex-col gap-4">
            <div class="bg-white rounded-2xl border border-slate-200/60 shadow-[0_8px_30px_rgb(0,0,0,0.04)] overflow-hidden">
                <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
                    <h3 class="text-sm font-black text-slate-800 uppercase tracking-wide">Today's DICOM Studies</h3>
                    <a href="/patients" class="text-xs font-bold text-blue-600 hover:text-blue-700 bg-blue-50 px-3 py-1.5 rounded-lg transition-colors">View All</a>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200/80 text-[10px] font-black text-slate-500 uppercase tracking-widest">
                                <th class="px-6 py-4 rounded-tl-lg">Patient</th>
                                <th class="px-6 py-4">Modality</th>
                                <th class="px-6 py-4">Accession</th>
                                <th class="px-6 py-4">Images</th>
                                <th class="px-6 py-4">Status</th>
                                <th class="px-6 py-4 text-right rounded-tr-lg">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100/80 text-sm font-medium text-slate-700">
                            @foreach (var s in Model.Studies)
                            {
                                <tr class="hover:bg-blue-50/50 transition-colors group">
                                    <td class="px-6 py-4">
                                        <div class="font-bold text-slate-900 group-hover:text-blue-700 transition-colors">@s.PatientName</div>
                                        <div class="text-[11px] text-slate-400 font-semibold mt-0.5">@s.PatientId</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-2 py-1 rounded border border-slate-200 bg-white shadow-sm text-slate-600 font-bold text-[10px] uppercase tracking-wider">@s.Modality</span>
                                    </td>
                                    <td class="px-6 py-4 text-slate-500 font-mono text-[11px] tracking-tight">@s.AccessionNumber</td>
                                    <td class="px-6 py-4 text-slate-600 font-bold">@s.ImageCount</td>
                                    <td class="px-6 py-4">
                                        @if (s.Status == ClariMed.Data.Models.StudyStatus.Receiving)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-100 text-amber-700 border border-amber-200 shadow-sm text-[10px] font-black tracking-wider uppercase">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                                Receiving
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-700 border border-emerald-200 shadow-sm text-[10px] font-black tracking-wider uppercase">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]"></span>
                                                Complete
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <a href="/preview/@s.Id" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-blue-600 hover:text-white border border-blue-200 hover:bg-blue-600 hover:border-blue-600 rounded-lg shadow-sm transition-all hover:shadow-md">
                                            Preview
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                                            </svg>
                                        </a>
                                    </td>
                                </tr>
                            }
                            @if (Model.Studies.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="px-6 py-16 text-center">
                                        <div class="flex flex-col items-center justify-center">
                                            <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mb-4">
                                                <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                                            </div>
                                            <p class="text-sm font-bold text-slate-600">No DICOM Studies</p>
                                            <p class="text-xs text-slate-400 mt-1">Waiting for images from the DICOM server.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Modalities List (1/3 width) -->
        <div>
            <div class="bg-white rounded-2xl border border-slate-200/60 p-6 shadow-[0_8px_30px_rgb(0,0,0,0.04)] sticky top-6">
                <h3 class="text-sm font-black text-slate-800 uppercase tracking-wide mb-6">Modality Distribution</h3>
                <div class="space-y-6">
                    @{
                        var colors = new[] { "bg-blue-500", "bg-emerald-500", "bg-violet-500", "bg-amber-500", "bg-rose-500" };
                        int idx = 0;
                    }
                    @foreach (var m in Model.ModalityBreakdown)
                    {
                        var percentage = Model.TotalStudies > 0 ? (int)Math.Round((double)m.Count / Model.TotalStudies * 100) : 0;
                        var colorClass = colors[idx % colors.Length];
                        idx++;
                        
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">@m.Modality</span>
                                <div class="flex items-baseline gap-1.5">
                                    <span class="text-sm font-black text-slate-900">@percentage%</span>
                                    <span class="text-[10px] text-slate-400 font-bold tracking-widest">(@m.Count)</span>
                                </div>
                            </div>
                            <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden shadow-inner">
                                <div class="h-full @colorClass rounded-full transition-all duration-1000 shadow-sm" style="width: @percentage%"></div>
                            </div>
                        </div>
                    }
                    @if (Model.ModalityBreakdown.Count == 0)
                    {
                        <div class="flex flex-col items-center justify-center py-10">
                            <svg class="w-10 h-10 text-slate-200 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path></svg>
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">No Data</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>