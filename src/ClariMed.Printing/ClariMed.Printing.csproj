<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Existing -->
    <PackageReference Include="FreeSpire.Doc" Version="14.4.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <!-- Cover page generation -->
    <PackageReference Include="QuestPDF" Version="2024.10.2" />
    <!-- PDF merging -->
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <!-- Silent PDF printing (pdfium.dll native engine).
         PdfiumViewer targets .NET Framework but works on net8.0-windows
         because it only uses System.Drawing APIs. NU1701 is safe to suppress. -->
    <PackageReference Include="PdfiumViewer" Version="2.13.0" NoWarn="NU1701" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" NoWarn="NU1701" />
  </ItemGroup>

</Project>

