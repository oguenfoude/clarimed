@model FocusMed.Dashboard.Areas.Dashboard.Pages.PatientsModel

<div id="patients-table" class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead>
                <tr class="border-b border-slate-100 text-[10px] font-semibold text-slate-400 uppercase tracking-wider">
                    <th class="px-5 py-3">@Loc["Patients_Col_Patient"]</th>
                    <th class="px-5 py-3">@Loc["Patients_Col_Modality"]</th>
                    <th class="px-5 py-3">@Loc["Patients_Col_Accession"]</th>
                    <th class="px-5 py-3">@Loc["Patients_Col_Date"]</th>
                    <th class="px-5 py-3">Status</th>
                    <th class="px-5 py-3 text-right">@Loc["Patients_Col_Actions"]</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var s in Model.Studies)
                {
                    <tr class="hover:bg-slate-50 transition-colors group">
                        <td class="px-5 py-3">
                            <div class="text-sm font-semibold text-slate-800">@s.PatientName</div>
                            <div class="text-[11px] text-slate-400 mt-0.5">@s.PatientId</div>
                        </td>
                        <td class="px-5 py-3">
                            <span class="px-2 py-0.5 bg-slate-100 border border-slate-200 rounded text-[10px] font-bold text-slate-600 uppercase tracking-wide">@s.Modality</span>
                        </td>
                        <td class="px-5 py-3 text-[11px] font-mono text-slate-500">@s.AccessionNumber</td>
                        <td class="px-5 py-3 text-[11px] text-slate-500 font-medium">
                            @(s.StudyDate?.ToString("MMM dd, yyyy") ?? s.CreatedAt.ToString("MMM dd, yyyy"))
                        </td>
                        <td class="px-5 py-3">
                            @if (s.Status == FocusMed.Data.Models.StudyStatus.Receiving)
                            {
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200 text-[10px] font-bold">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                                    Receiving
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-bold">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                    Complete
                                </span>
                            }
                        </td>
                        <td class="px-5 py-3 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a href="/preview/@s.Id"
                                   class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-blue-600 hover:text-white bg-blue-50 hover:bg-blue-600 border border-blue-200 hover:border-blue-600 rounded-lg transition-all">
                                    @Loc["Patients_Btn_Preview"]
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" class="inline"
                                      onsubmit="return confirm('Delete this study and all its files permanently?');">
                                    <button type="submit"
                                            class="p-1.5 text-slate-300 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-all opacity-0 group-hover:opacity-100"
                                            title="@Loc["Patients_Btn_Delete"]">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Studies.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="px-5 py-20 text-center">
                            <div class="flex flex-col items-center">
                                <svg class="w-10 h-10 text-slate-200 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                                <p class="text-sm font-semibold text-slate-500">@Loc["Patients_NoResults"]</p>
                                <p class="text-xs text-slate-400 mt-1">@Loc["Patients_NoResultsDesc"]</p>
                                <button type="button"
                                        onclick="clearPatientsFilters();"
                                        class="mt-4 px-3 py-1.5 text-xs font-semibold text-slate-500 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-lg transition-all">
                                    Clear filters
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>