@page "/system-stop"
@model SystemStopModel
@{
    ViewData["Title"] = "Stop System";
}

<div class="max-w-xl mx-auto mt-10 p-6 bg-white rounded-xl shadow-sm border border-slate-200">
    <div class="text-center mb-6">
        <svg class="w-16 h-16 text-rose-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <h2 class="text-2xl font-bold text-slate-800">Stop Application Safely</h2>
        <p class="text-slate-500 mt-2">
            This will cleanly shut down the FocusMed background services and this web interface. 
            Once stopped, you must restart the service manually from Windows Services or the system tray application.
        </p>
    </div>

    @if (Request.Method == "POST")
    {
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 p-4 rounded-lg text-center font-medium">
            Shutdown sequence initiated. The application will close momentarily. You can safely close this browser window.
        </div>
    }
    else
    {
        <form method="post" class="flex justify-center mt-6">
            <button type="submit" class="px-6 py-3 bg-rose-600 hover:bg-rose-700 text-white font-semibold rounded-lg shadow-md transition-colors flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                Confirm Stop System
            </button>
        </form>
    }
</div>
