@page "/dashboard"
@model FocusMed.Dashboard.Areas.Dashboard.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="space-y-6">

    <!-- Top Row: Stat + Modality -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-5">

        <!-- Total Patients Card -->
        <div class="relative bg-white border border-slate-200 rounded-xl p-6 shadow-sm overflow-hidden flex flex-col justify-between">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-50/60 to-transparent pointer-events-none"></div>
            <div class="relative">
                <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4">@Loc["Dashboard_TotalPatients"]</p>
                <p class="text-5xl font-black text-slate-900 tracking-tight">@Model.TotalPatients</p>
            </div>
            <div class="relative mt-6 flex items-center gap-2 text-xs text-slate-400 font-medium">
                <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Total registered patients
            </div>
        </div>

        <!-- Today's Modality Breakdown -->
        <div class="lg:col-span-3 bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
            <div class="flex items-center justify-between mb-5">
                <div>
                    <h2 class="text-sm font-bold text-slate-800">@Loc["Dashboard_TodayModality"]</h2>
                    <p class="text-xs text-slate-400 mt-0.5">@DateTime.Today.ToString("dddd, MMMM d, yyyy")</p>
                </div>
                <div class="flex items-center gap-1.5 text-[10px] font-bold text-emerald-600 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    Live
                </div>
            </div>

            @if (Model.ModalityBreakdown.Count == 0)
            {
                <div class="flex flex-col items-center justify-center py-10 text-slate-400">
                    <svg class="w-10 h-10 mb-3 text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
                    <p class="text-sm font-semibold text-slate-500">@Loc["Dashboard_NoStudies"]</p>
                    <p class="text-xs text-slate-400 mt-1">@Loc["Dashboard_NoStudiesDesc"]</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-3">
                    @foreach (var m in Model.ModalityBreakdown)
                    {
                        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center hover:border-blue-300 hover:bg-blue-50/40 transition-all group cursor-default">
                            <p class="text-2xl font-black text-slate-800 group-hover:text-blue-700 transition-colors">@m.Count</p>
                            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1 group-hover:text-blue-500 transition-colors">@m.Modality</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

</div>